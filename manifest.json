{
  "version": "8.3.0",
  "name": "__MSG_PKG_NAME__",
  "manifest_version": 3,
  "description": "__MSG_PKG_DESC__",
  "default_locale": "en",
  "icons": {
    "16": "assets/icons/ic16.png",
    "32": "assets/icons/ic32.png",
    "48": "assets/icons/ic48.png",
    "96": "assets/icons/ic96.png",
    "128": "assets/icons/ic128.png",
    "256": "assets/icons/ic256.png",
    "512": "assets/icons/ic512.png"
  },
  "action": {
    "default_title": "LexiHalo"
  },
  "options_ui": {
    "page": "byok.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://*/cdn-cgi/challenge-platform/*"
      ],
      "js": ["assets/edvideo-onload.js"],
      "css": ["assets/edvideo.css", "assets/subtitle-ai.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://*/cdn-cgi/challenge-platform/*"
      ],
      "js": [
        "assets/romanize-main.js",
        "assets/ld-main.js",
        "assets/tagger-main.js",
        "assets/edvideo-main.js"
      ],
      "run_at": "document_end",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.challenges.cloudflare.com/*",
        "*://*/cdn-cgi/challenge-platform/*"
      ],
      "js": [
        "assets/site-rules-loader.js",
        "assets/tagger-main.js",
        "assets/ld-main.js",
        "assets/edreader-main.js",
        "assets/subtitle-ai-sidebar.js"
      ],
      "css": ["assets/subtitle-ai.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      },
      "description": "__MSG_toggleVideoImmersive__"
    },
    "fulltext-translate": {
      "suggested_key": {
        "default": "Alt+E",
        "mac": "Alt+E"
      },
      "description": "__MSG_toggleFulltextImmersive__"
    },
    "quick-translator": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Alt+D"
      },
      "description": "__MSG_quickTranslator__"
    },
    "ai-transcribe": {
      "description": "__MSG_aiTranscribe__"
    },
    "caption-toggle": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "__MSG_captionToggle__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "host_permissions": ["<all_urls>"],
  "permissions": ["storage", "contextMenus", "unlimitedStorage", "nativeMessaging", "offscreen", "scripting", "webRequest", "declarativeNetRequestWithHostAccess"]
}
